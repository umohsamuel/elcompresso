# Public hostname of the API. Point a DNS A record at your EC2 Elastic IP.
# No domain? Use <elastic-ip-with-dashes>.sslip.io, e.g. 13-50-1-2.sslip.io
API_DOMAIN=api.example.com

# Your Vercel URL(s). The wildcard covers preview deployments.
ALLOWED_ORIGINS=https://elcompresso.vercel.app,https://elcompresso-*.vercel.app

# Caddy runs on the Docker network; trust it for client IPs.
TRUSTED_PROXIES=172.16.0.0/12

STORAGE_TYPE=local
RESULT_TTL=1h

# S3 instead of local disk (attach an IAM instance role with s3:PutObject,
# s3:GetObject and s3:DeleteObject on the bucket; no keys needed):
# STORAGE_TYPE=s3
# AWS_REGION=eu-north-1
# AWS_BUCKET=my-elcompresso-bucket

# Tune to the instance: ~1 worker per 2 vCPUs.
WORKERS=2
QUEUE_SIZE=100
JOB_TIMEOUT=30m

MAX_VIDEO_MB=1024
MAX_AUDIO_MB=200
MAX_IMAGE_MB=50
RATE_LIMIT_PER_MINUTE=30
MAX_ACTIVE_JOBS_PER_IP=5

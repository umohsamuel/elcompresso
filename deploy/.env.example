# Written by the GitHub Actions deploy from the "production" environment;
# only needed by hand for a manual deploy. Limits are in limits.env.

# Public hostname of the API (DNS A record -> the instance's Elastic IP).
API_DOMAIN=elcompresso-api.umohsg.com

# Browser origins allowed to call the API (comma-separated, one * wildcard each).
ALLOWED_ORIGINS=https://elcompresso.umohsg.com,https://elcompresso-*.vercel.app

# Loopback port host nginx proxies to (shared instance setup).
API_PORT=9003

# S3 instead of local disk (attach an IAM instance role; no keys needed):
# STORAGE_TYPE=s3
# AWS_REGION=eu-north-1
# AWS_BUCKET=my-elcompresso-bucket

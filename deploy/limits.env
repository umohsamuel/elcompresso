# Processing limits, sized for the shared instance (2 vCPU, ~1 GB free RAM,
# ~14 GB free disk). Uploads and results live on the instance's disk until
# they expire, so roughly MAX_VIDEO_MB x 2 x (QUEUE_SIZE + WORKERS) must fit.
#
# If you change MAX_VIDEO_MB, change client_max_body_size in nginx.conf too
# (and on the server, in /etc/nginx/sites-available/<API_DOMAIN>).

# nginx reaches the container through the Docker bridge.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

STORAGE_TYPE=local
RESULT_TTL=30m

# One encode at a time: 2 vCPUs are shared with the other apps.
WORKERS=1
QUEUE_SIZE=4
# A 500 MB video can take a while on 2 vCPUs.
JOB_TIMEOUT=60m
FFMPEG_THREADS=2

MAX_VIDEO_MB=500
MAX_AUDIO_MB=200
MAX_IMAGE_MB=50
MAX_IMAGE_MEGAPIXELS=100

RATE_LIMIT_PER_MINUTE=10
MAX_ACTIVE_JOBS_PER_IP=2

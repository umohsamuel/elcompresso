{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ElcompressoObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/uploads/*",
        "arn:aws:s3:::BUCKET_NAME/compressed/*"
      ]
    },
    {
      "Sid": "HeadMissingObjectsAs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    }
  ]
}
